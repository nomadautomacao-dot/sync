# ── Dependencies ──
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──
/.next/
/out/
/build

# ── Environment ──
.env*
!.env.example
# Config web do Firebase — pública por construção, e o build precisa dela.
!.env.production
cloudrun.env.yaml

# ── TypeScript ──
*.tsbuildinfo

# ── Large data files ──
*.xlsx
*.csv
!data/fnde/*.csv
*.db
*.sqlite
*.zip
*.tmp

# ── Temporary files ──
tmp_*
output/
scratch/
graphify-out/
scripts/payloads_temp/

# ── Flutter build artifacts ──
sync_flutter/build/
sync_flutter/.dart_tool/
sync_flutter/android/build/
sync_flutter/.idea/
sync_flutter/output/
sync_flutter/tmp_*
sync_flutter/*.log

# ── Python cache ──
__pycache__/
*.pyc

# ── OS / IDE ──
.DS_Store
*.pem
*.swp
*.swo
*~
Thumbs.db

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Documentos de negócio ──
# O lugar deles é ../Sync-Arquivos/, fora do repositório.
# Ver docs/superpowers/specs/2026-07-22-reorganizacao-estrutura-design.md
*.pdf
!data/fnde/*.pdf
*.doc
*.docx
/*.html
relatorios_*/
data/_sinopses/
data/batch/
.superpowers/

# ── Cloud Functions ──
functions/node_modules/
functions/lib/

# Added by code-review-graph
.code-review-graph/

# Local-only tool state
# `.kilo/` traz `node_modules` proprio (61 MB) e ainda fazia o Vitest varrer os
# testes internos do zod — ver a exclusao em `vitest.config.ts`.
.kilo/
firestore-debug.log
firebase-debug.log
*.pid
.claude/worktrees/
.mcp.json
.vscode/
opencode.jsonc
.claude/skills/
.impeccable/

# App desktop — tudo derivado: o ícone sai de public/global-sync-icon.png,
# o Chromium sai do cache do Playwright e o pacote sai dos dois.
/dist-desktop/
/desktop/icones/
/desktop/.chromium/
