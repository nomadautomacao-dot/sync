# ── Dependencies ──
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──
/.next/
/out/
/build

# ── Environment ──
.env*
cloudrun.env.yaml

# ── TypeScript ──
*.tsbuildinfo

# ── Large data files ──
*.xlsx
*.csv
!data/fnde/*.csv
*.db
*.sqlite
*.zip
*.tmp

# ── Temporary files ──
tmp_*
output/
scratch/

# ── Flutter build artifacts ──
sync_flutter/build/
sync_flutter/.dart_tool/

# ── Python cache ──
__pycache__/
*.pyc

# ── OS / IDE ──
.DS_Store
*.pem
*.swp
*.swo
*~
Thumbs.db

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Documents ──
documents/*.zip
