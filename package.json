{
  "name": "sync",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:credenciais": "node scripts/desktop/credenciais-locais.mjs",
    "desktop:icones": "node scripts/desktop/gerar-icones.mjs",
    "desktop:preparar": "node --max-old-space-size=8192 node_modules/next/dist/bin/next build && node scripts/desktop/preparar-servidor.mjs",
    "desktop:empacotar": "npm run desktop:icones && npm run desktop:preparar && electron-builder --config electron-builder.yml",
    "dev": "next dev --webpack -p 3100",
    "dev:next": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke/run.ts",
    "firebase:claims": "node scripts/firebase/set-claims.mjs",
    "fundeb:analyze-models": "node scripts/pdf/analyze-fundeb-pdf-models.mjs",
    "fundeb:compare-pdfs": "node scripts/pdf/compare-fundeb-pdf-pair.mjs",
    "fundeb:compare-pdfs-batch": "node scripts/pdf/compare-fundeb-pdf-batch.mjs",
    "fundeb:executive-report": "node scripts/pdf/generate-fundeb-executive-report.mjs",
    "dados:caged": "node scripts/dados/gerar-caged-municipios.mjs",
    "dados:equidade": "node scripts/dados/gerar-equidade-censo-municipal.mjs",
    "dados:vaar": "node scripts/dados/gerar-vaar-municipios.mjs",
    "dados:ideb-escolas": "node --use-system-ca scripts/dados/gerar-ideb-escolas.mjs",
    "dados:indicadores-escolas": "node --use-system-ca scripts/dados/gerar-indicadores-escolas.mjs",
    "dados:saeb-distribuicao": "node --use-system-ca scripts/dados/gerar-saeb-distribuicao.mjs",
    "dados:violencia": "node scripts/dados/gerar-violencia-municipios.mjs",
    "dados:escolas-territorio": "node --use-system-ca scripts/dados/gerar-escolas-territorio.mjs",
    "dados:enem": "node --use-system-ca scripts/dados/gerar-enem-abstencao.mjs",
    "dados:emendas": "node scripts/dados/gerar-emendas-municipios.mjs",
    "dados:cor-raca": "node --use-system-ca scripts/dados/gerar-cor-raca-historico.mjs",
    "dados:alfabetizacao": "node --use-system-ca scripts/dados/gerar-alfabetizacao-municipios.mjs",
    "dados:assentamentos": "node scripts/dados/gerar-assentamentos-incra.mjs",
    "dados:remuneracao": "node --max-old-space-size=8192 scripts/dados/gerar-remuneracao-docente.mjs",
    "dados:siope": "node scripts/dados/gerar-siope-indicadores.mjs",
    "dados:terras-indigenas": "node scripts/dados/gerar-terras-indigenas.mjs",
    "dados:vacinacao": "node scripts/dados/gerar-cobertura-vacinal.mjs",
    "dados:violencia-infantil": "node scripts/dados/gerar-violencia-infantil.mjs",
    "dados:ponderadas": "node --max-old-space-size=6144 scripts/dados/gerar-matriculas-ponderadas.mjs",
    "dados:trabalho-infantil": "node scripts/dados/gerar-trabalho-infantil.mjs",
    "firebase:regras": "npx --yes firebase-tools@latest deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/pro-components": "^3.1.14-6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.5.3",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.13",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "numero-por-extenso": "^1.0.8",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "png-to-ico": "^3.0.2",
    "shadcn": "^4.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
