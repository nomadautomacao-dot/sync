rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myGroupId() {
      return request.auth.token.groupId;
    }
    function myRole() {
      return request.auth.token.groupRole;
    }
    function isAdmin() {
      return isSignedIn() && myRole() in ['owner', 'admin'];
    }
    // Apagar de vez e so da dona — nem a administradora.
    //
    // As outras travas perguntam "quem opera"; esta pergunta "quem destroi".
    // Remover um documento tira o binario do Storage e o registro daqui: nao ha
    // lixeira, nao ha desfazer, e auditoria nao recupera arquivo. Copia fiel de
    // `podeApagarDefinitivamente` em core/domain/rbac.ts.
    function isOwner() {
      return isSignedIn() && myRole() == 'owner';
    }

    // Permissao fina por area (roadmap multiusuario, fase 1).
    //
    // A matriz padrao de cada papel e as travas (owner/admin tem tudo; abaixo
    // de admin, sistemas nao abre e ajustes nao edita) sao copia fiel de
    // `permissoesPadrao`/`permissoesEfetivas` em core/domain/rbac.ts — a fonte
    // de verdade e la: mudou la, muda aqui. A claim `perm` carrega so os
    // DESVIOS do padrao do papel (ver claimsDeAcesso em core/lib/acessos.ts).
    //
    // Mapeamento area -> colecoes com escrita enforceada:
    //   cidades:    cities (+ eventos, etapas, contatos, comentarios),
    //               contratos, cityReports, reportJobs
    //   documentos: cityDocuments, empresaDocumentos
    //   pessoas:    collaborators, collaboratorDocuments
    //   caixa:      mural (+ respostas)
    //   ajustes:    workspace_settings (a trava do rbac ja a limita a admin)
    // Writes exigem nivel 'editar' na area; leituras seguem exigindo so o grupo.

    // O padrao do papel para a area, antes de qualquer ajuste da claim.
    function nivelPadrao(area) {
      return myRole() in ['owner', 'admin'] ? 'editar'
        : myRole() == 'member'
          ? (area in ['ajustes', 'sistemas'] ? 'nenhum'
            : (area == 'pessoas' ? 'ver' : 'editar'))
        : myRole() == 'viewer'
          ? (area in ['ajustes', 'sistemas'] ? 'nenhum' : 'ver')
        : 'nenhum';
    }

    // O nivel que vale: ajuste da claim por cima do padrao, com as travas
    // aplicadas por ultimo — nenhum ajuste consegue fura-las.
    function nivelArea(area) {
      let configurado = 'perm' in request.auth.token
        ? request.auth.token.perm.get(area, nivelPadrao(area))
        : nivelPadrao(area);
      return isAdmin() ? 'editar'
        : area == 'sistemas' ? 'nenhum'
        : (area == 'ajustes' && configurado == 'editar' ? 'ver' : configurado);
    }

    function podeEditarArea(area) {
      return isSignedIn() && nivelArea(area) == 'editar';
    }

    // O eixo administrativo: contrato, valores e remuneracao.
    //
    // Nao e area — area e o catalogo da barra lateral, e este dado atravessa
    // telas que a colaboradora precisa abrir de qualquer jeito. Copia fiel de
    // `podeVerAdministrativo` em core/domain/rbac.ts: mudou la, muda aqui.
    //
    // Nome proprio, mesma regra de isAdmin(), pelo mesmo motivo de
    // podeAdministrarAcessos/podeAdministrarSistemas no dominio: sao poderes
    // distintos que hoje calham de exigir o mesmo papel, e fundi-los faria
    // afrouxar um afrouxar os outros sem ninguem perceber.
    //
    // ESTE e o unico lugar onde a restricao vale. Esconder a aba na tela tira
    // o contrato da vista e nao do alcance de quem abrir o SDK no navegador.
    function veAdministrativo() {
      return isSignedIn() && myRole() in ['owner', 'admin'];
    }

    match /collaborators/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('pessoas') && request.resource.data.groupId == myGroupId();
      allow update: if podeEditarArea('pessoas')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId();
      // Sem delete real: exclusao e soft delete (update de deletedAt).
      allow delete: if false;
    }

    // `companies` e `employees` sairam em 2026-08-13, com a tela de Empresas.
    // A Global e a unica empresa, e a identidade dela vive em
    // `core/domain/empresa.ts` — que e de onde contrato e PDF leem. Sem regra,
    // o acesso e negado: os documentos que ficaram no banco continuam la, mas
    // ninguem os le. Repor a regra os traz de volta.

    match /cities/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades') && request.resource.data.groupId == myGroupId();
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId()
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedAt'])
                      || isAdmin()
                    );
      allow delete: if false;
    }

    match /workspace_settings/{groupId} {
      allow read: if isSignedIn() && groupId == myGroupId();
      allow create, update: if isAdmin() && groupId == myGroupId()
                            && request.resource.data.groupId == myGroupId();
      allow delete: if false;
    }

    // O inbox da equipe (roadmap multiusuario, fase 2). Não há coleção de
    // usuários para fan-out: `destinatarioUid: null` é o aviso para o grupo
    // inteiro, e um uid é o aviso para uma pessoa só.
    //
    // Leitura: as minhas e as do grupo. Update: só o campo `lida`, e só na
    // própria — a notificação de grupo é compartilhada e o estado de leitura
    // dela é o carimbo em `workspace_settings/{groupId}/leituras/{uid}`, não
    // este documento. Delete não existe: aviso lido fica para trás sozinho,
    // como e-mail arquivado.
    match /notifications/{id} {
      allow read: if isSignedIn()
                  && resource.data.groupId == myGroupId()
                  && (resource.data.destinatarioUid == null
                      || resource.data.destinatarioUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.keys().hasOnly([
                         'groupId', 'destinatarioUid', 'tipo', 'titulo', 'resumo',
                         'link', 'lida', 'criadoEm', 'origemUid', 'origemNome'
                       ])
                    && (request.resource.data.destinatarioUid == null
                        || request.resource.data.destinatarioUid is string)
                    && request.resource.data.tipo in [
                         'pergunta_mural', 'comentario_evento', 'etapa_atribuida',
                         'emissao_concluida', 'emissao_erro'
                       ]
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0
                    && request.resource.data.titulo.size() <= 200
                    && request.resource.data.lida == false
                    && request.resource.data.criadoEm is string
                    && request.resource.data.origemUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.groupId == myGroupId()
                    && resource.data.destinatarioUid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lida']);
      allow delete: if false;
    }

    // Carimbo de leitura das notificações de grupo: cada pessoa guarda o seu,
    // e só o seu. O doc do grupo é compartilhado — o "já vi" não cabe nele.
    match /workspace_settings/{groupId}/leituras/{uid} {
      allow read: if isSignedIn() && groupId == myGroupId() && uid == request.auth.uid;
      allow create, update: if isSignedIn()
                            && groupId == myGroupId()
                            && uid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['ultimaLeituraEm'])
                            && request.resource.data.ultimaLeituraEm is string;
      allow delete: if false;
    }

    match /audit/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      // Escrita de auditoria só via backend confiavel (Cloud Functions), nunca cliente.
      allow write: if false;
    }

    // A linha do tempo do municipio. Quem escreve e a equipe inteira — e por
    // isso a regra de edicao e aqui, e nao na tela: esconder o botao e
    // conveniencia, o que impede alguem de reescrever o registro de outra
    // pessoa e esta linha. Sem ela, o historico que a equipe usa para se
    // entender poderia ser alterado por qualquer um, sem rastro.
    //
    // Delete nao existe para ninguem: acontecimento registrado e fato, e
    // apagar fato de uma base compartilhada e pior que corrigi-lo. Cancelar e
    // um estado do proprio evento.
    // O mural da equipe. Conversa, nao registro de sistema.
    //
    // Editar so o proprio texto, e nem admin reescreve fala alheia: mural em
    // que a chefia corrige o que os outros disseram deixa de ser lugar onde as
    // pessoas dizem o que pensam. Admin apaga (spam, dado sensivel no lugar
    // errado) — apagar e assumido, reescrever e silencioso.
    //
    // A excecao do `resolvidoEm` existe porque encerrar pergunta e ato de quem
    // perguntou **ou** de quem administra, e sem ela um admin nao conseguiria
    // fechar pergunta de alguem que saiu da empresa.
    match /mural/{postId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('caixa')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.autorUid == request.auth.uid
                    && request.resource.data.texto is string;
      allow update: if podeEditarArea('caixa')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == resource.data.groupId
                    && request.resource.data.autorUid == resource.data.autorUid
                    && (
                         resource.data.autorUid == request.auth.uid
                         // Encerrar/reabrir pergunta e responder mexem so
                         // nesses campos.
                         || isAdmin()
                         || request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['respostas'])
                         || request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['resolvidoEm', 'resolvidoPor'])
                       );
      allow delete: if isAdmin() && resource.data.groupId == myGroupId();
    }

    match /mural/{postId}/respostas/{respostaId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('caixa')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.autorUid == request.auth.uid;
      allow update: if podeEditarArea('caixa')
                    && resource.data.autorUid == request.auth.uid
                    && request.resource.data.autorUid == resource.data.autorUid;
      allow delete: if isAdmin() && resource.data.groupId == myGroupId();
    }

    match /cities/{cityId}/eventos/{eventoId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.autorUid == request.auth.uid;
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId()
                    // Autoria nao se transfere: quem escreveu continua sendo
                    // quem escreveu, mesmo quando um admin corrige o texto.
                    && request.resource.data.autorUid == resource.data.autorUid
                    && (
                         resource.data.autorUid == request.auth.uid
                         || isAdmin()
                         // Comentar no evento de outra pessoa adianta o contador
                         // dela, e so ele. Sem esta clausula, quem comentasse
                         // levava "permissao negada" — e a mensagem culparia a
                         // pessoa por um erro de modelagem.
                         || request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly(['comentarios'])
                       );
      allow delete: if false;
    }

    // O cronograma de implantacao. Aqui, ao contrario dos eventos, qualquer
    // pessoa da equipe edita qualquer etapa: etapa nao e registro de autoria, e
    // sim o estado combinado do trabalho — quem esta na cidade hoje conclui a
    // etapa que a colega marcou semana passada, e isso e o uso normal.
    //
    // Delete existe porque etapa avulsa criada por engano nao e fato registrado,
    // e deixa-la de pe suja o processo de todo mundo. So admin apaga.
    match /cities/{cityId}/etapas/{etapaId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades') && request.resource.data.groupId == myGroupId();
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId();
      allow delete: if isAdmin() && resource.data.groupId == myGroupId();
    }

    // Contatos sao diretorio, nao fato: a pessoa muda de cargo, o telefone
    // muda de dono, a eleicao troca a prefeitura inteira. Por isso qualquer
    // pessoa do grupo edita e apaga — a trava de autor dos eventos nao se
    // aplica, e o historico que merece registro mora na linha do tempo.
    // Projetos, capacitacoes, programas e servicos abertos no municipio.
    //
    // Area `cidades`, e nao o eixo administrativo: quem organiza a capacitacao
    // e a colaboradora que esta na prefeitura — e o proposito da aba e
    // justamente dar a ela um lugar para trabalhar sem passar pelo contrato.
    //
    // `delete` e false, como em eventos e contratos: iniciativa aberta e fato,
    // e cancelar e um estado dela. Apagar tiraria da historia da cidade o
    // projeto que a equipe combinou e desfez, que e o que alguem vai querer
    // reler seis meses depois.
    match /cities/{cityId}/iniciativas/{iniciativaId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.autorUid == request.auth.uid;
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId()
                    // Autoria nao se transfere, como nos eventos: quem abriu
                    // continua sendo quem abriu, mesmo quando outra pessoa
                    // encerra — e encerrar por outra pessoa e o uso normal.
                    && request.resource.data.autorUid == resource.data.autorUid;
      allow delete: if false;
    }

    match /cities/{cityId}/contatos/{contatoId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades') && request.resource.data.groupId == myGroupId();
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId();
      allow delete: if podeEditarArea('cidades') && resource.data.groupId == myGroupId();
    }

    match /cities/{cityId}/eventos/{eventoId}/comentarios/{comentarioId} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.autorUid == request.auth.uid;
      allow update: if podeEditarArea('cidades')
                    && resource.data.autorUid == request.auth.uid
                    && request.resource.data.autorUid == resource.data.autorUid;
      allow delete: if false;
    }

    match /cities/{cityId}/profitSnapshots/{competencia} {
      allow read:  if isSignedIn() && resource.data.groupId == myGroupId();
      allow write: if false; // so Cloud Functions (Admin SDK) via registrarProfitSnapshot
    }

    // Contrato registrado e fato: negociacao que morre vira "cancelado", nao
    // apaga. Por isso delete e false para todo mundo — a historia do que
    // valeu (e do que quase valeu) fica.
    match /contratos/{id} {
      // Leitura restrita, ao contrario do resto da base. O unico consumidor e
      // a aba Contrato da ficha da cidade, que ja nao aparece para quem nao
      // alcanca o administrativo — travar aqui nao tira funcionalidade de
      // ninguem e fecha o caminho de ler pelo SDK sem passar pela tela.
      allow read: if veAdministrativo() && resource.data.groupId == myGroupId();
      // Escrita pelo mesmo eixo, e nao por podeEditarArea('cidades'): `member`
      // nasce com 'editar' em cidades, e sem esta troca a colaboradora nao so
      // lia como criava e alterava contrato.
      allow create: if veAdministrativo() && request.resource.data.groupId == myGroupId();
      allow update: if veAdministrativo()
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId();
      allow delete: if false;
    }

    match /commissionRules/{id} {
      // Remuneracao e administrativo. Nenhuma tela le esta colecao: quem a
      // consome sao as Cloud Functions pelo Admin SDK, que ignora estas regras.
      allow read:  if veAdministrativo() && resource.data.groupId == myGroupId();
      allow write: if false; // regras sao criadas por admin via console/Function futura
    }

    match /commissionAccruals/{id} {
      // Remuneracao e administrativo. Nenhuma tela le esta colecao: quem a
      // consome sao as Cloud Functions pelo Admin SDK, que ignora estas regras.
      allow read:  if veAdministrativo() && resource.data.groupId == myGroupId();
      allow write: if false; // so fecharCompetencia (Admin SDK)
    }

    match /commissionPayouts/{id} {
      // Remuneracao e administrativo. Nenhuma tela le esta colecao: quem a
      // consome sao as Cloud Functions pelo Admin SDK, que ignora estas regras.
      allow read:  if veAdministrativo() && resource.data.groupId == myGroupId();
      allow write: if false; // totais so via onAccrualWrite (Admin SDK)
    }

    match /collaboratorDocuments/{id} {
      allow read:   if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('pessoas') && request.resource.data.groupId == myGroupId();
      allow delete: if podeEditarArea('pessoas') && resource.data.groupId == myGroupId();
      allow update: if false; // metadado e imutavel apos criado; para trocar, apaga e sobe de novo
    }

    // Habilitacao da empresa: documentos da Global, sem cidade dona. Update
    // existe (ao contrario de cityDocuments) porque renovar certidao e mudar
    // a data de validade — o caso de uso central desta colecao. Delete tambem:
    // certidao vencida substituida e papel velho, nao historia.
    match /empresaDocumentos/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('documentos')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.categoria is string
                    && request.resource.data.titulo is string
                    && request.resource.data.storagePath is string;
      allow update: if podeEditarArea('documentos')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId();
      allow delete: if podeEditarArea('documentos') && resource.data.groupId == myGroupId();
    }

    // Metadado editavel (corrigir titulo, data de validade), arquivo e autoria
    // imutaveis — a lista de campos editaveis espelha CityDocument em
    // modules/documentos/types.ts. Apagar e ato do autor ou de quem administra:
    // documento apagado nao tem "cancelado" como contrato tem.
    // Os tipos de projeto que a equipe criou ("Formacao continuada",
    // "Assessoria"). Area `cidades`, e nao `ajustes`: quem precisa de um tipo
    // novo e quem esta montando o projeto na prefeitura, e workspace_settings
    // exige isAdmin() — um "+" que da permissao negada para a pessoa a quem ele
    // foi feito e pior que nao ter o "+".
    //
    // Delete existe, ao contrario de quase tudo aqui, porque tipo nao e fato: e
    // vocabulario. E apagar um nao derruba projeto nenhum —
    // `definicaoDaIniciativa` devolve rotulo neutro para chave desconhecida.
    match /tiposDeIniciativa/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.key is string
                    && request.resource.data.rotulo is string;
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId();
      allow delete: if podeEditarArea('cidades') && resource.data.groupId == myGroupId();
    }

    match /cityDocuments/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('documentos')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.cityId is string
                    && request.resource.data.title is string
                    && request.resource.data.storagePath is string;
      // Metadado e troca de versao. Os campos de arquivo entraram aqui porque
      // substituir o arquivo e um update, nao um documento novo — e a lista de
      // chaves permitidas continua fechada: quem edita nao alcanca `cityId`,
      // `groupId`, `createdBy` nem `source`.
      allow update: if podeEditarArea('documentos')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['title', 'description', 'category',
                                   'contractNumber', 'signedAt', 'expiresAt',
                                   'fileName', 'fileSize', 'mimeType',
                                   'storagePath', 'downloadUrl',
                                   'versao', 'versoesAnteriores'])
                    // Versao so anda para frente, e o historico so cresce.
                    // Sem isto, "substituir" poderia devolver o documento a uma
                    // versao anterior e descartar o que ja estava guardado —
                    // apagar pela porta dos fundos, sem passar por isOwner().
                    //
                    // Os dois `get` com padrao existem porque a maioria dos
                    // updates nao toca em versao nenhuma (renomear titulo,
                    // trocar categoria): ler o campo direto rejeitaria essas
                    // edicoes com "permissao negada" num documento que nunca
                    // foi versionado.
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['versao', 'versoesAnteriores'])
                        || (request.resource.data.get('versao', 0)
                              > resource.data.get('versao', 0)
                            && request.resource.data.get('versoesAnteriores', []).size()
                              > resource.data.get('versoesAnteriores', []).size()));
      // So a dona apaga. Antes, a autora do upload apagava o proprio
      // documento — e e assim que se perde arquivo numa equipe: quem subiu por
      // engano apaga meia hora depois o que ja virou anexo de processo.
      allow delete: if isOwner() && resource.data.groupId == myGroupId();
    }

    match /cityReports/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.cityId is string
                    && request.resource.data.codigoIbge is string
                    && request.resource.data.title is string
                    // A lista precisa acompanhar CITY_REPORT_TYPES
                    // (modules/cidades/reports-types.ts). Ja divergiu duas
                    // vezes, e o efeito e silencioso ate o fim: o PDF e gerado,
                    // o upload vai ao Storage e so a gravacao do JSON e negada
                    // aqui — o usuario ve "Missing or insufficient permissions"
                    // depois de esperar a emissao inteira.
                    //
                    // O comentario nao bastou nas duas vezes. Agora quem cobra
                    // e `modules/cidades/regras-relatorios.test.ts`, que le este
                    // arquivo e compara com o codigo.
                    && request.resource.data.type in [
                         'raio_x', 'diagnostico_fundeb', 'dever_de_casa',
                         'historico_censo', 'oficio_documentos',
                         'dossie_escolas', 'dossie_conformidade',
                         'dossie_matricula', 'dossie_dinheiro',
                         'dossie_aprendizagem', 'dossie_demanda',
                         'dossie_equidade', 'dossie_comparativo'
                       ]
                    && request.resource.data.generationId is string
                    && request.resource.data.snapshot is map
                    && request.resource.data.snapshotBytes is int
                    && request.resource.data.snapshotBytes > 0
                    && request.resource.data.snapshotBytes < 900000;
      allow delete: if isAdmin() && resource.data.groupId == myGroupId();
      allow update: if false;
    }

    // Fila de emissão: um pedido de relatório por documento, processado pela
    // janela aberta (core/providers/fila-emissao-provider.tsx). Diferente de
    // cityReports, aqui update é permitido — o ciclo de vida do pedido é
    // exatamente uma sequência de updates de status.
    match /reportJobs/{id} {
      allow read: if isSignedIn() && resource.data.groupId == myGroupId();
      allow create: if podeEditarArea('cidades')
                    && request.resource.data.groupId == myGroupId()
                    && request.resource.data.cityId is string
                    && request.resource.data.documentoId is string
                    && request.resource.data.status in ['pendente', 'gerando', 'concluido', 'erro'];
      allow update: if podeEditarArea('cidades')
                    && resource.data.groupId == myGroupId()
                    && request.resource.data.groupId == resource.data.groupId
                    && request.resource.data.status in ['pendente', 'gerando', 'concluido', 'erro'];
      allow delete: if podeEditarArea('cidades') && resource.data.groupId == myGroupId();
    }
  }
}
