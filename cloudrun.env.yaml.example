# Variáveis do serviço no Cloud Run.
#
# ⚠️ Este arquivo só é usado quando alguém passa `--env-file` para os scripts de
# deploy — e passar isso SUBSTITUI o conjunto inteiro de variáveis do serviço,
# não soma. Uma chave que falte aqui é uma chave APAGADA da produção.
#
# No fluxo normal o deploy troca só a imagem e preserva o que já está
# configurado no serviço. Use `--env-file` apenas quando a intenção for mesmo
# reescrever tudo — e, nesse caso, confira antes o que está no ar:
#
#   gcloud run services describe sync-app --region=us-central1 \
#     --format="value(spec.template.spec.containers[0].env[].name)"
#
# Em 2026-08-05 o serviço tinha exatamente estas cinco:

# Obrigatória. Sem ela, `getSessionUser()` devolve null e TODA rota dá 401.
FIREBASE_SERVICE_ACCOUNT: '{"type":"service_account","project_id":"globalconsultorias",...}'

NODE_ENV: "production"

# Indicadores educacionais (qedu-api.ts). Sem ela os dossiês perdem o Saeb.
QEDU_TOKEN: "seu-token-qedu"

# Portal da Transparência. Responde mal ao Cloud Run — é uma das razões do app
# desktop existir (seção 10 do CLAUDE.md).
PORTAL_TRANSPARENCIA_TOKEN: "sua-chave-da-api-do-portal-da-transparencia"

OPENROUTER_API_KEY: "sua-chave-openrouter"

# ── Não ressuscitar ────────────────────────────────────────────────────────
#
# DATABASE_URL, DIRECT_URL — o Prisma/Postgres saiu do código; nada as lê.
# NEXTAUTH_URL, NEXTAUTH_SECRET, GOOGLE_CLIENT_ID/SECRET — a autenticação é
#   Firebase Auth desde a migração; não há NextAuth no projeto.
# SYNC_LOGIN_EMAIL/PASSWORD/NAME — login semeado, morto junto com o Postgres.
# NODE_TLS_REJECT_UNAUTHORIZED — desliga a verificação de certificado do
#   processo INTEIRO. Aceitável no `.env` local; em produção, não.
